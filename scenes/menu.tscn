[sub_resource type="GDScript" id="GDScript_kvpfn"]
resource_name = "grass_randomizer"
script/source = "extends Node2D


@export_range(0.0, 15.0, 0.1) var skew_random:float = 1.0
@export_range(0.0, 5.0, 0.1) var rotation_random:float = 1.0
@export_range(0.0, 0.1, 0.05) var scale_random:float = 0.05


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	for grass:Sprite2D in get_children():
		grass.skew += randf_range(-skew_random, skew_random)
		grass.rotation_degrees += randf_range(-rotation_random, rotation_random)
		grass.scale += Vector2.ONE * randf_range(-scale_random, scale_random)
		grass.flip_h = randf() > 0.5
"

